        {"diameter": 0.8, "drill": 0.4},
        {"diameter": 1.0, "drill": 0.5}
      ],
      "diff_pair_dimensions": [],
      "custom_rules": "version 1\nrule \"GND plane solid on B.Cu\"\n  constraint clearance (min 0.2mm)\n  condition \"A.Layer == 'B.Cu' && B.Layer == 'B.Cu'\"\n\nrule \"CH signals short\"\n  constraint track_width (min 0.25mm max 0.25mm)\n  condition \"A.NetClass == 'CH'\"\n\nrule \"Power 0.5mm\"\n  constraint track_width (min 0.5mm)\n  condition \"A.NetClass == 'Power'\"\n"
