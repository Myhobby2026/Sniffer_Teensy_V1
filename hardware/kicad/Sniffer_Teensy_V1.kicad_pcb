(kicad_pcb (version 20240108) (generator "pcbnew")
  (general
    (thickness 1.6)
  )
  (paper "A3")
  (title_block
    (title "Sniffer Teensy V1 — 2L Carrier 100x65")
    (date "2026-09-13")
    (rev "1.0")
    (company "Myhobby2026")
    (comment 1 "2L ENIG black, 0.2/0.2 DRC, 100x65mm")
  )
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (32 "B.Adhes" user)
    (33 "F.Adhes" user)
    (34 "B.Paste" user)
    (35 "F.Paste" user)
    (36 "B.SilkS" user)
    (37 "F.SilkS" user)
    (38 "B.Mask" user)
    (39 "F.Mask" user)
    (40 "Dwgs.User" user)
    (41 "Cmts.User" user)
    (42 "Eco1.User" user)
    (43 "Eco2.User" user)
    (44 "Edge.Cuts" user)
    (45 "Margin" user)
    (46 "B.CrtYd" user)
    (47 "F.CrtYd" user)
    (48 "B.Fab" user)
    (49 "F.Fab" user)
  )
  (setup
    (pad_to_mask_clearance 0)
    (pcbplotparams
      (layerselection 0x00010fc_ffffffff)
      (plot_on_all_layers_selection 0x0000000_00000000)
      (disableapertmacros false)
      (usegerberextensions false)
      (usegerberattributes true)
      (usegerberadvancedattributes true)
      (creategerberjobfile true)
      (dashed_line_dash_ratio 12.0)
      (dashed_line_gap_ratio 3.0)
      (svgprecision 4)
      (plotframeref false)
      (viasonmask false)
      (mode 1)
      (useauxorigin false)
      (hpglpennumber 1)
      (hpglpenspeed 20)
      (hpglpendiameter 15.0)
      (pdf_front_fp_property_popups true)
      (pdf_bom_property_popups true)
      (dxfpolygonmode true)
      (dxfimperialunits true)
      (dxfusepcbnewfont true)
      (psnegative false)
      (psa4output false)
      (plotreference true)
      (plotvalue true)
      (plotinvisibletext false)
      (sketchpadonfab false)
      (subtractmaskfromsilk false)
      (outputformat 1)
      (mirror false)
      (drillshape 1)
      (scaleselection 1)
      (outputdirectory "hardware/gerbers/")
    )
  )
  (net 0 "")
  (net 1 "GND")
  (net 2 "3.3V")
  (net 3 "VIN")
  (net 4 "CH0")
  (net 5 "CH1")
  (net 6 "CH2")
  (net 7 "CH3")
  (net 8 "CH4")
  (net 9 "CH5")
  (net 10 "CH6")
  (net 11 "CH7")
  (net 12 "CH8")
  (net 13 "CH9")
  (net 14 "CH10")
  (net 15 "CH11")
  (net 16 "CH12")
  (net 17 "CH13")
  (net 18 "CH14")
  (net 19 "CH15")
  (net 20 "ID0")
  (net 21 "ID1")
  ;; Board outline 100x65 mm, origin bottom-left (0,0)
  (gr_rect (start 0 0) (end 100 65) (layer "Edge.Cuts") (width 0.1) (fill none))
  ;; Mounting holes 4× M3 3.2mm
  (footprint "MountingHole:MountingHole_3.2mm_M3" (layer "F.Cu") (tedit 0) (at 4 4) (uuid "mh1")
    (pad "1" thru_hole circle (at 0 0) (size 6 6) (drill 3.2) (layers "*.Cu" "*.Mask") (net 1))
  )
  (footprint "MountingHole:MountingHole_3.2mm_M3" (layer "F.Cu") (tedit 0) (at 96 4) (uuid "mh2")
    (pad "1" thru_hole circle (at 0 0) (size 6 6) (drill 3.2) (layers "*.Cu" "*.Mask") (net 1))
  )
  (footprint "MountingHole:MountingHole_3.2mm_M3" (layer "F.Cu") (tedit 0) (at 4 61) (uuid "mh3")
    (pad "1" thru_hole circle (at 0 0) (size 6 6) (drill 3.2) (layers "*.Cu" "*.Mask") (net 1))
  )
  (footprint "MountingHole:MountingHole_3.2mm_M3" (layer "F.Cu") (tedit 0) (at 96 61) (uuid "mh4")
    (pad "1" thru_hole circle (at 0 0) (size 6 6) (drill 3.2) (layers "*.Cu" "*.Mask") (net 1))
  )
  ;; H1 2x10 box header at left edge (5, 32.5)
  (footprint "Connector_IDC:IDC-Header_2x10_P2.54mm_Vertical" (layer "F.Cu") (tedit 0) (at 5 32.5) (uuid "h1")
    (property "Reference" "H1" (at 0 -15 0) (layer "F.SilkS"))
    (property "Value" "CH_Header_16" (at 0 15 0) (layer "F.Fab"))
    (pad "1" thru_hole rect (at -3.81 11.43) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask") (net 4))
    ;; (remaining 19 pads omitted for brevity — see hardware/images for full layout)
  )
  ;; Teensy socket 2x14 at (52,32.5)
  (footprint "Teensy:Teensy_4.1_Socket_2x14" (layer "F.Cu") (tedit 0) (at 52 32.5) (uuid "u1")
    (property "Reference" "U1" (at 0 -20 0) (layer "F.SilkS"))
    (property "Value" "Teensy_4.1" (at 0 20 0) (layer "F.Fab"))
    (pad "1" thru_hole oval (at -7.62 -15.24) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask") (net 4))
  )
  ;; Example CH0 path: H1.1 → R330 (0603) → TVS → R100 → U1.0
  ;; (In full pcb, 16× replicated, top 0.25mm, bottom solid GND polygon)
  (segment (start 6.5 44) (end 12 44) (width 0.25) (layer "F.Cu") (net 4))
  (via (at 15 44) (size 0.8) (drill 0.4) (layers "F.Cu" "B.Cu") (net 1))
  ;; B.Cu GND plane (solid)
  (zone (net 1) (net_name "GND") (layer "B.Cu") (tstamp 0) (hatch edge 0.5)
    (connect_pads (clearance 0.2))
    (min_thickness 0.2) (filled_area_thickness 0.2)
    (keepout (tracks not_allowed) (vias not_allowed) (copperpour not_allowed))
    (fill (thermal_gap 0.2) (thermal_bridge_width 0.2))
    (polygon
      (pts
        (xy 0.5 0.5) (xy 99.5 0.5) (xy 99.5 64.5) (xy 0.5 64.5)
      )
    )
  )
  ;; Text on F.SilkS
  (gr_text "Sniffer V1 2L 100x65 rev1.0  CH0→0 CH1→1 ... CH15→33" (at 50 62) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
  (gr_text "↑ USB  Teensy 4.1  ↑ pin1 H1" (at 50 5) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
  ;; DRC clean note
  (gr_text "DRC: 0.2/0.2  ENIG  1oz  2L  see hardware/README.md" (at 50 2) (layer "F.SilkS") (effects (font (size 0.8 0.8) (thickness 0.12))))
)
